    "This instance runs Gitea %@. Cup requires v%@ or later — some features may not work." : {
      "comment" : "Warning shown on the home screen when the Gitea server version is below the minimum required version.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Instanz läuft mit Gitea %1$@. Cup benötigt v%2$@ oder neuer – einige Funktionen könnten nicht funktionieren."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此实例运行 Gitea %1$@。Cup 需要 v%2$@ 或更高版本，部分功能可能无法使用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此執行個體執行 Gitea %1$@。Cup 需要 v%2$@ 或更新版本，部分功能可能無法使用。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta instancia ejecuta Gitea %1$@. Cup requiere la v%2$@ o posterior; es posible que algunas funciones no funcionen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette instance exécute Gitea %1$@. Cup nécessite la v%2$@ ou une version ultérieure ; certaines fonctionnalités peuvent ne pas fonctionner."
          }
